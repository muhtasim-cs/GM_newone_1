{
  "name": "agri-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "indexer:docker": "docker compose up --build gram-indexer",
    "indexer:build": "docker build -t gram-indexer -f Dockerfile.indexer ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "solc": "^0.8.24",
    "turbo": "^2.4.4",
    "typescript-eslint": "^8.26.1"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "lodash": "^4.17.21",
    "rxjs": "^7.8.2",
    "viem": "^2.56.5"
  }
}
