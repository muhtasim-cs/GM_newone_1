{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "API_PORT",
    "API_HOST",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_EXPIRATION",
    "JWT_REFRESH_SECRET",
    "JWT_REFRESH_EXPIRATION",
    "CORS_ORIGIN",
    "BLOCKCHAIN_RPC_URL",
    "BLOCKCHAIN_CHAIN_ID",
    "BLOCKCHAIN_PRIVATE_KEY",
    "BLOCKCHAIN_CONFIRMATIONS",
    "PROJECT_REGISTRY_ADDRESS",
    "DEAL_FACTORY_ADDRESS",
    "ESCROW_ADDRESS",
    "PROFIT_DISTRIBUTION_ADDRESS",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_REGION",
    "PAYMENT_PROVIDER",
    "PAYMENT_API_KEY",
    "PAYMENT_WEBHOOK_SECRET",
    "LOG_LEVEL",
    "SENTRY_DSN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV", "API_PORT", "API_HOST", "DATABASE_URL", "REDIS_URL"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
