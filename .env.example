# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/agri_platform
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRATION=7d

# Server
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Blockchain
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=1
USE_RUST_INDEXER=true
INDEXER_POLL_INTERVAL_MS=1500
INDEXER_MAX_BLOCK_RANGE=2000
INDEXER_REORG_BUFFER_BLOCKS=12

# Smart Contracts
PROJECT_REGISTRY_ADDRESS=
DEAL_FACTORY_ADDRESS=
ESCROW_ADDRESS=
PROFIT_DISTRIBUTION_ADDRESS=

# Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agri-platform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Payment (Mock/Testnet)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Notification & Email Certificates
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="GramBondhon <notifications@grambondhon.bd>"

# Monitoring
SENTRY_DSN=
LOG_LEVEL=debug

# Zapier & External Webhooks
ZAPIER_WEBHOOK_ENABLED=true
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_WEBHOOK_ID/
ZAPIER_WEBHOOK_SECRET=your-optional-zapier-secret
